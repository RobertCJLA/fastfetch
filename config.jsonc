{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/Rimuru-Tempest-Powerful-Protagonist-That-Time-I-Got-Reincarnated-as-a-Slime.png",
    "width": 35,
    "height": 18,
    "padding": {
      "right": 4,
      "top": 2
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
        "keys": "magenta"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "          {1}@{2}",
      "color": {
          "user": "magenta",
          "at": "white",
          "host": "blue"
      }
    },
    "break",
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────────────────┐",
      "color": "magenta"
    },
    {
      "key": "     OS       ",
      "keyColor": "32", 
      "type": "os"
    },
    {
      "key": "    󰌢 Machine  ",
      "keyColor": "36",
      "type": "host"
    },
    {
      "key": "     Kernel   ",
      "keyColor": "34",
      "type": "kernel"
    },
    {
      "key": "    󰅐 Uptime   ",
      "keyColor": "32",
      "type": "uptime"
    },
    {
      "key": "     Packages ",
      "keyColor": "36",
      "type": "packages"
    },
    {
      "key": "     WM       ",
      "keyColor": "34",
      "type": "wm"
    },
    {
      "key": "     Shell    ",
      "keyColor": "32",
      "type": "shell"
    },
    {
      "key": "     Terminal ",
      "keyColor": "36",
      "type": "terminal"
    },
    {
      "key": "     Font     ",
      "keyColor": "34",
      "type": "terminalfont"
    },
    {
      "key": "    󰻠 CPU      ",
      "keyColor": "32",
      "type": "cpu"
    },
    {
      "key": "    󰍛 GPU      ",
      "keyColor": "36",
      "type": "gpu"
    },
    {
      "key": "    󰑭 Memory   ",
      "keyColor": "34",
      "type": "memory"
    },
    {
      "key": "     Wifi     ",
      "keyColor": "32",
      "type": "wifi"
    },
    {
      "key": "    󰩟 Local IP ",
      "keyColor": "36",
      "type": "localip",
      "compact": true
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────────┘",
      "color": "magenta"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 4,
      "symbol": "circle",
      "block": {
        "width": 6
      }
    }
  ]
}